# Docker Compose reads this file after you copy it to .env at the repository root.
# Keep the copied .env file local; it is ignored by Git.
# Compose supplies the internal MongoDB URI and production NODE_ENV to the backend.
# NEXT_PUBLIC_API_URL is baked into the browser bundle during the frontend build.

JWT_SECRET=replace-with-a-long-local-secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_EXPIRES_HOURS=24
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="CreditSea <no-reply@example.com>"

# Cloudinary is required when testing salary-slip upload and preview.
CLOUDINARY_CLOUD_NAME=replace-with-your-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret
